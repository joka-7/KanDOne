# Optional cloud sync to the user's own Google Drive.
#
# KanDOne is offline-first and works fully without this. Set it to show the
# "Connect Drive" button: tasks then sync to a hidden app-only folder in each
# user's own Google Drive (drive.appdata scope). There is no KanDOne server or
# database in that path.
#
# Value: an OAuth 2.0 Client ID of type "Web application" from Google Cloud
# Console → APIs & Services → Credentials, with this site's origin under
# "Authorized JavaScript origins". It is a public identifier, not a secret.

VITE_GOOGLE_CLIENT_ID=
