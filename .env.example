# Optional cloud sync (Google Sign-In + Firestore).
#
# KanDOne is offline-first: leave these unset and the app runs entirely on
# localStorage. When unset, isCloudConfigured() is false, the Firebase SDK is
# never loaded, and the header omits "Connect Drive".
#
# Get the values from the Firebase console: Project settings → Your apps → Web
# app. They are public client identifiers, not secrets — they ship in the
# client bundle by design. Access is controlled by firestore.rules and by
# Authentication → Authorized domains.
#
# All six must be set for cloud sync to switch on; a partial set counts as
# unconfigured.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
